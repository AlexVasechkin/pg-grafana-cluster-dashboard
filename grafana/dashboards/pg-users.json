        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "instant": true,
          "expr": "count(up{job=\"postgres-users\", pg_cluster=\"$pg_cluster\"} == 1 and on(pg_cluster, node) (pgcls_node_is_primary == 1)) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "НЕТ ДАННЫХ С ЛИДЕРА — пустые таблицы ниже не означают «всё хорошо»",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Сбор работает",
                  "color": "green",
                  "index": 1
                }
              }
            }
