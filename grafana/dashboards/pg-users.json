    {
      "type": "table",
      "id": 3,
      "title": "[M46] Срок действия истёк",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "description": "Роли, у которых `rolvaliduntil` уже в прошлом: вход по паролю для них отклоняется. Недавно истёкшие — сверху. Бессрочные роли (NULL / infinity) сюда не попадают. Список сужен фильтром БД: только роли с CONNECT на $db_name. Фильтр схемы не влияет.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (rolname, rolcanlogin, rolsuper) (1000 * pgcls_role_valid_until_seconds{pg_cluster=\"$pg_cluster\"} * on(pg_cluster, node, rolname) group_left(rolcanlogin, rolsuper) pgcls_role_info{pg_cluster=\"$pg_cluster\"} and on(pg_cluster, node, rolname) (pgcls_role_valid_until_seconds{pg_cluster=\"$pg_cluster\"} < time()) and on(pg_cluster, node) (pgcls_node_is_primary == 1) and on(pg_cluster, node, rolname) pgcls_role_db_access{pg_cluster=\"$pg_cluster\", db_name=\"$db_name\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (rolname) ((time() - pgcls_role_valid_until_seconds{pg_cluster=\"$pg_cluster\"} > 0) and on(pg_cluster, node) (pgcls_node_is_primary == 1) and on(pg_cluster, node, rolname) pgcls_role_db_access{pg_cluster=\"$pg_cluster\", db_name=\"$db_name\"})",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "rolname",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "rolname": "Пользователь",
              "Value #A": "VALID UNTIL",
              "Value #B": "Просрочено",
              "rolcanlogin": "LOGIN",
              "rolsuper": "Superuser"
            },
            "excludeByName": {},
            "indexByName": {
              "rolname": 0,
              "Value #A": 1,
              "Value #B": 2,
              "rolcanlogin": 3,
              "rolsuper": 4
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Пользователь",
                "VALID UNTIL",
                "Просрочено",
                "LOGIN",
                "Superuser"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Нет таких пользователей"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Пользователь"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "VALID UNTIL"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              },
              {
                "id": "custom.width",
                "value": 130
              }
